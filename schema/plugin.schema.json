{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AICyberGuardian/grok-bot-templates-evolved/schema/plugin.schema.json",
  "title": "Grok Bot Plugin Marketplace Manifest",
  "type": "object",
  "required": ["name", "description", "version", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "description"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "compatibility": {
            "type": "object",
            "additionalProperties": true
          },
          "repository": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mcp": { "type": "string" }
        }
      }
    }
  }
}
